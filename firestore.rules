rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'jimmydeji@gmail.com'; }

    match /studentProfile/{userId} {
      allow read, list: if isOwner(userId) || isAdmin();
      allow create: if (isOwner(userId) && request.resource.data.isActivated == false) || isAdmin();
      allow update, delete: if isOwner(userId) || isAdmin();
      match /chatMessages/{messageId} {
        allow read, write: if isOwner(userId);
      }
    }
    match /quizAttempts/{attemptId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
    }
    match /activationCodes/{codeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }
    match /paymentRequests/{requestId} {
      allow read: if isSignedIn() || isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() || isAdmin();
    }
  }
}

// Rules updated
