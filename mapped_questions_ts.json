{id: "phy-ss1-85",subjectId: "physics",grade: "SS1",term: "2nd Term",topic: "Nuclear Physics",examType: "WAEC",year: 1995,questionNumber: 85,question: "In a controlled thermal fission reactor, control rods are used to",options: {A: "generate energy",B: "control the rate of production of neutrons",C: "control the speed of neutrons released on fission",D: "control the amount of radiation produced"},correctOption: "B",explanation: "Control rods absorb excess neutrons to control the rate of the chain reaction.",difficulty: "medium",verificationStatus: "AI_GENERATED_PRACTICE",contentType: "text"},
{id: "phy-ss1-86",subjectId: "physics",grade: "SS1",term: "2nd Term",topic: "Electromagnetism",examType: "WAEC",year: 1994,questionNumber: 86,question: "The process of producing electric current by a changing magnetic field is referred to as",options: {A: "magnet induction",B: "electromagnetic induction",C: "flux linkage",D: "electrostatic induction"},correctOption: "B",explanation: "This is electromagnetic induction (Faraday's law).",difficulty: "medium",verificationStatus: "AI_GENERATED_PRACTICE",contentType: "text"},
{id: "phy-ss1-87",subjectId: "physics",grade: "SS1",term: "2nd Term",topic: "Waves",examType: "WAEC",year: 1993,questionNumber: 87,question: "The distance between a node and an antinode in a stationary wave is equal to",options: {A: "one-quarter of the wavelength",B: "one-half of the wavelength",C: "the wavelength",D: "twice the wavelength"},correctOption: "A",explanation: "Node to antinode distance is λ/4.",difficulty: "medium",verificationStatus: "AI_GENERATED_PRACTICE",contentType: "text"},
{id: "phy-ss1-88",subjectId: "physics",grade: "SS1",term: "2nd Term",topic: "Density",examType: "WAEC",year: 1993,questionNumber: 88,question: "40 m³ of liquid P is mixed with 60 m³ of another liquid Q. If the densities of P and Q are 1.00 kg/m³ and 1.6 kg/m³, respectively, what is the density of the mixture?",options: {A: "0.05 kg/m³",B: "1.25 kg/m³",C: "1.30 kg/m³",D: "1.36 kg/m³"},correctOption: "D",explanation: "Total mass = 40×1 + 60×1.6 = 40 + 96 = 136 kg. Total volume = 100 m³. Density = 1.36 kg/m³.",difficulty: "medium",verificationStatus: "AI_GENERATED_PRACTICE",contentType: "text"},
{id: "phy-ss1-89",subjectId: "physics",grade: "SS1",term: "2nd Term",topic: "Upthrust",examType: "WAEC",year: 1992,questionNumber: 89,question: "An object weighs 30 N in air and 21 N in water. The weight of the object when completely immersed in a liquid of relative density 1.4 is",options: {A: "25.2 N",B: "17.4 N",C: "12.6 N",D: "9.0 N"},correctOption: "B",explanation: "Upthrust in water = 9 N. Upthrust in liquid = 1.4×9 = 12.6 N. Weight in liquid = 30 − 12.6 = 17.4 N.",difficulty: "medium",verificationStatus: "AI_GENERATED_PRACTICE",contentType: "text"},
{id: "phy-ss1-90",subjectId: "physics",grade: "SS1",term: "2nd Term",topic: "Moments",examType: "WAEC",year: 1992,questionNumber: 90,question: "A uniform meter rule QR is balanced on a knife edge, which is 55 cm from R. When a mass of 10 g is hung at P, the mass of the meter rule is",options: {A: "550 g",B: "350 g",C: "70 g",D: "35 g"},correctOption: "C",explanation: "Taking moments about pivot: 10 × 35 = m × 5 ⇒ m = 70 g.",difficulty: "medium",verificationStatus: "AI_GENERATED_PRACTICE",contentType: "text"},
{id: "phy-ss1-91",subjectId: "physics",grade: "SS1",term: "2nd Term",topic: "Simple Pendulum",examType: "WAEC",year: 1991,questionNumber: 91,question: "A simple pendulum, 0.6 m long, has a period of 1.5 s. What is the period of a similar pendulum 0.4 m long in the same location?",options: {A: "1.5√(2/3) s",B: "1.5√(3/2) s",C: "2.25 s",D: "1.00 s"},correctOption: "A",explanation: "T ∝ √L. T₂ = 1.5√(0.4/0.6) = 1.5√(2/3).",difficulty: "medium",verificationStatus: "AI_GENERATED_PRACTICE",contentType: "text"},
